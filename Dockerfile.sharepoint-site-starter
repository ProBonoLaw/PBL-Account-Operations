FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/SharePointSiteStarter/NuGet.Config src/SharePointSiteStarter/
COPY src/SharePointSiteStarter/SharePointSiteStarter.csproj src/SharePointSiteStarter/
RUN dotnet restore src/SharePointSiteStarter/SharePointSiteStarter.csproj \
    --configfile src/SharePointSiteStarter/NuGet.Config
COPY src/SharePointSiteStarter/ src/SharePointSiteStarter/
RUN dotnet publish src/SharePointSiteStarter/SharePointSiteStarter.csproj \
    --configuration Release --no-restore --output /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
COPY --from=build /app .
USER $APP_UID
ENTRYPOINT ["dotnet", "SharePointSiteStarter.dll"]
