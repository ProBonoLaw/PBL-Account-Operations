FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/ResourceManager/NuGet.Config src/ResourceManager/
COPY src/ResourceManager/ResourceManager.csproj src/ResourceManager/
RUN dotnet restore src/ResourceManager/ResourceManager.csproj \
    --configfile src/ResourceManager/NuGet.Config
COPY src/ResourceManager/ src/ResourceManager/
RUN dotnet publish src/ResourceManager/ResourceManager.csproj \
    --configuration Release --no-restore --output /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
COPY --from=build /app .
USER $APP_UID
ENTRYPOINT ["dotnet", "ResourceManager.dll"]
